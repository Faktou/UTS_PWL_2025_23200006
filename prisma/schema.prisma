generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model preorder {
  id                Int @id @default(autoincrement())
  order_date        DateTime
  order_by          String
  selected_package  String
  qty               Int
  is_paid           Boolean
}

model pckg {
  id          Int @id @default(autoincrement())
  kode        String
  nama        String
  deskripsi   String
}

model customer {
  id        Int @id @default(autoincrement())
  nama      String
  nomor     String
  email     String
  createdAt DateTime @default(now())
}